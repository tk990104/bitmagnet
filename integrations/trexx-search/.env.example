# Copy this file to .env and paste the key from Prowlarr Settings > General.
PROWLARR_API_KEY=replace-with-your-prowlarr-api-key

# These defaults are for the included Docker Compose file on Windows/macOS.
PROWLARR_URL=http://host.docker.internal:9696
BITMAGNET_URL=http://host.docker.internal:3333
TREXX_RESULT_LIMIT=100
TREXX_HTTP_TIMEOUT=15s
