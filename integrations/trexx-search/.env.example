# Optional override for Prowlarr running outside the included Compose stack.
# The included stack discovers its local key automatically.
PROWLARR_API_KEY=replace-with-your-prowlarr-api-key

# The included Compose stack connects to Prowlarr and bitmagnet by service name.
# Override these only when using services outside the included stack.
PROWLARR_URL=http://prowlarr:9696
BITMAGNET_URL=http://bitmagnet:3333
TREXX_RESULT_LIMIT=100
TREXX_HTTP_TIMEOUT=15s
